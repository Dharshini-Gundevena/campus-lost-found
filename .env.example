# ── Campus Lost & Found – Environment Variables ───────────────
# Copy this file to .env and fill in the values before running.
#
#   cp .env.example .env
#
# All variables must be prefixed with VITE_ to be exposed
# to the Vite frontend bundle.

# Base URL for the backend REST API
# Example: http://localhost:4000/api  or  https://api.yourdomain.com
VITE_API_BASE_URL=
